library(readr)
library(dplyr)
library(here)
library(ggplot2)
library(plotrix)
#library(segmented)
library(Routliers)
library(tidyverse)
library(ggpubr)
library(car)
library(data.table)
library(lme4)
library(nlme)
library(emmeans)
library(sjstats)
library(lmerTest)
library(MuMIn)
#library(nortest)
#library(effects)
dir_1k_DR <- "./Data_1k_DR"
data_1k_DR <-
list.files(path=dir_1k_DR, pattern = "*.csv",full.names = TRUE) %>%
map_df(~fread(.) %>% mutate(trial_Order = row_number())) %>%
mutate(freq = "1k")
dir_1k_DR <- "./Data_1k_DR"
data_1k_DR <-
list.files(path=dir_1k_DR, pattern = "*.csv",full.names = TRUE) %>%
map_df(~fread(.) %>% mutate(trial_Order = row_number())) %>%
mutate(freq = "1k")
rm(dir_1k_DR)
library(showtext)
font_add(family = "Times", regular = "TIMES.ttf")
showtext_auto()
theme_set(theme_bw(base_family = "Times"))
update_geom_defaults(
geom = "text",
aes(family = "Times")
)
# Corregimos la columna de condicion con una etiqueta mas legible
data_1k_DR$condicion[data_1k_DR$condicion==0] <- "WW"
data_1k_DR$condicion[data_1k_DR$condicion==1] <- "LL"
data_1k_DR$condicion[data_1k_DR$condicion==2] <- "LW"
data_1k_DR$condicion[data_1k_DR$condicion==3] <- "WL"
orden_bloques <- read.csv("./orden_bloques.csv")
data_1k_DR <- merge(x=orden_bloques,y=data_1k_DR,
by=c("nsub","condicion"))
# Erase redundant columns
data_1k_DR <- data_1k_DR[, !names(data_1k_DR) %in% c("bloque","altura")]
rm(orden_bloques)
data_1k_DR <- data_1k_DR %>% mutate(room = ifelse(nsub <= 28, "Salta", "Bernal"))
data_1k_DR <- data_1k_DR[!(data_1k_DR$nsub %in% c(4,55,56,69)), ]
data <- data_1k_DR %>%
mutate(log_bias=log(respuesta/distancia),
abs_log_bias = abs(log(respuesta/distancia)))
data_avg <- data %>% #data_clean %>% filter(is_outlier_sd==FALSE) %>%
group_by(nsub, condicion,freq,distancia) %>%
summarise(mean_log_bias = mean(log_bias),
abs_mean_log_bias = mean(abs_log_bias),
.groups = "drop")
data_outliers <- data_avg %>%
group_by(distancia,condicion,freq) %>%
summarise(
abs_mean_log_bias = outliers_mad(abs_mean_log_bias,threshold = 3)$outliers
) %>%
ungroup()
data_avg_clean <- anti_join(data_avg, data_outliers)
data_clean <- data%>% #data_clean %>%
group_by(nsub, condicion,freq,distancia) %>%
mutate(mean_log_bias = mean(log_bias),
abs_mean_log_bias = mean(abs_log_bias)) %>%
ungroup() %>%
mutate(is_outlier = !(paste(nsub, distancia,condicion,freq,
mean_log_bias, abs_mean_log_bias) %in%
paste(data_avg_clean$nsub,
data_avg_clean$distancia,
data_avg_clean$condicion,
data_avg_clean$freq,
data_avg_clean$mean_log_bias,
data_avg_clean$abs_mean_log_bias)))
sum(data_clean$is_outlier==TRUE)
191/3
