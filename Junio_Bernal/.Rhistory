data_clean$condicion <- as.factor(data_clean$condicion)
data_clean$condicion <- relevel(data_clean$condicion, ref = "WW")
#Modelo LMEM sobre LOG LOG
lmer.1k <- lmer(log(respuesta) ~ log(distancia) * condicion +
(1 + log(distancia) | nsub) +
(0 + condicion | nsub),
data = data_clean %>% filter(freq=="1k", is_outlier_lb==FALSE))
#lmer.1k <- lmer(respuesta ~ distancia * condicion +
#          (1 + distancia | nsub),
#                 data = data_clean %>% filter(freq=="1k", is_outlier==FALSE),
#        control = lmerControl(optimizer = "bobyqa"))
summary(lmer.1k)
anova(lmer.1k)
##partial eta sq
effectsize::eta_squared(lmer.1k, partial = TRUE)
#Rsq
r.squaredGLMM(lmer.1k)
emmeans(lmer.1k,
list(pairwise ~ condicion),
adjust="bonferroni")
qqnorm(resid(lmer.1k))
# Original
lmer.1k <- lmer(log_bias ~ log(distancia) * condicion + (1 + log(distancia) | nsub),
data = data_clean %>% filter(freq=="1k", is_outlier_lb==FALSE))
summary(lmer.1k)
anova(lmer.1k)
##partial eta sq
effectsize::eta_squared(lmer.1k, partial = TRUE)
#Rsq
r.squaredGLMM(lmer.1k)
emmeans(lmer.1k,
list(pairwise ~ condicion),
adjust="bonferroni")
qqnorm(resid(lmer.1k))
# Original
lmer.1k.var <- lmer(varianza ~  condicion,
data = df_var)
# Original
lmer.1k.var <- lm(varianza ~  condicion,
data = df_var)
summary(lmer.1k.var)
anova(lmer.1k.var)
##partial eta sq
effectsize::eta_squared(lmer.1k.var, partial = TRUE)
#Rsq
r.squaredGLMM(lmer.1k.var)
emmeans(lmer.1k.var,
list(pairwise ~ condicion),
adjust="bonferroni")
qqnorm(resid(lmer.1k.var))
data_clean$condicion <- as.factor(data_clean$condicion)
data_clean$condicion <- relevel(data_clean$condicion, ref = "WW")
#Modelo LMEM sobre LOG LOG
