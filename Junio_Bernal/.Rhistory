#Modelo LMEM sobre LOG LOG
lmer.1k <- lmer(log(respuesta) ~ log(distancia) * condicion +
(1 + log(distancia) | nsub) +
(0 + condicion | nsub),
data = data_clean %>% filter(is_outlier==FALSE))
#lmer.1k <- lmer(respuesta ~ distancia * condicion +
#          (1 + distancia | nsub),
#                 data = data_clean %>% filter(freq=="1k", is_outlier==FALSE),
#        control = lmerControl(optimizer = "bobyqa"))
summary(lmer.1k)
anova(lmer.1k)
##partial eta sq
effectsize::eta_squared(lmer.1k, partial = TRUE)
#Rsq
r.squaredGLMM(lmer.1k)
emmeans(lmer.1k,
list(pairwise ~ condicion),
adjust="bonferroni")
qqnorm(resid(lmer.1k))
# Original
lm.var <- lm(varianza ~ condicion,
data = df_var)
summary(lm.var)
anova(lm.var)
##partial eta sq
effectsize::eta_squared(lm.var, partial = TRUE)
#Rsq
r.squaredGLMM(lm.var)
emmeans(lm.var,
list(pairwise ~ condicion),
adjust="bonferroni")
qqnorm(resid(lm.var))
