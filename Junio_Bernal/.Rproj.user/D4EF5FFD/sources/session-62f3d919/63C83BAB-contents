# (OLD) OUTLIERS POR Varianza del sesgo logarítmico.

Utilizo el sesgo logarítmico porque varía menos con la distancia, y no es una unidad asimétrica.
utilizo la varianza porque es una variacion no lineal y puede joder los calculos

```{r}
#Calculo el sesgo log para cada muestra
data <- data %>% 
  mutate(log_bias=log(respuesta/distancia))

# 1. Calcular la varianza por sujeto y distancia (3 repeticiones)
df_var <- data %>%
  group_by(nsub, distancia, condicion,freq) %>%
  summarise(
    var_bias = var(log_bias),
    .groups = "drop"
  )

# 2. Detectar sujetos/condiciones con variabilidad extrema (outliers en var)
outliers_var <- df_var %>%
  group_by(distancia,condicion,freq) %>%
  summarise(var_bias = outliers_mad(var_bias,threshold = 3)$outliers) %>%
  ungroup()

# Elimino los outliers del dataframe de promedios
df_var <- anti_join(df_var, outliers_var)

# Marco los outliers en el dataframe general
data_clean <- df_var %>%
  mutate(is_outlier_var = (paste(distancia,condicion,freq,
                              var_bias) %in%
                             paste(outliers_var$distancia,
                                   outliers_var$condicion,
                                   outliers_var$freq,
                                   outliers_var$var_bias)))


data_clean <- left_join(data_clean,data)
```

## Sesgo (BIAS)

El sesgo se calcula como el log(respuesta/distancia). Para el análisis se utiliza con signo. Sin embargo para quitar outliers, utilizamos el valor absoluto.

```{r}
#Calculo el sesgo log para cada muestra
data <- data %>% 
  mutate(log_bias=log(respuesta/distancia),
         abs_log_bias = abs(log(respuesta/distancia))) 

#Armo otro dataframe con los mean(log_bias) y abs(mean(log_bias))
data_avg <- data %>% #filter(is_outlier_var==FALSE) %>%
  group_by(nsub, condicion,freq,distancia) %>% 
  summarise(mean_log_bias = mean(log_bias),
            abs_mean_log_bias = mean(abs_log_bias),
    .groups = "drop")

#Identifico los outliers dentro de cada distancia, condicion, freq
data_outliers <- data_avg %>%
  group_by(distancia,condicion,freq) %>%
  summarise(
    abs_mean_log_bias = outliers_mad(abs_mean_log_bias,threshold = 3)$outliers
  ) %>%
  ungroup()


# Elimino los outliers del dataframe de promedios
data_avg_clean <- anti_join(data_avg, data_outliers)

# Marco los outliers en el dataframe general
data_clean <- data %>%
  group_by(nsub, condicion,freq,distancia) %>% 
  mutate(mean_log_bias = mean(log_bias), 
         abs_mean_log_bias = mean(abs_log_bias)) %>%
  ungroup() %>%
  mutate(is_outlier_lb = !(paste(nsub, distancia,condicion,freq,
                              mean_log_bias, abs_mean_log_bias) %in%
                             paste(data_avg_clean$nsub, 
                                   data_avg_clean$distancia,
                                   data_avg_clean$condicion,
                                   data_avg_clean$freq,
                                   data_avg_clean$mean_log_bias,
                                   data_avg_clean$abs_mean_log_bias)))

#data_clean <- semi_join(data_clean, data_avg_clean)
```

