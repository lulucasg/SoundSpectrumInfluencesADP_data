lmer.12m <- lmer(log_respuesta ~ log_distancia * condicion +
(1 + log_distancia | nsub) +
(0 + condicion | nsub),
data = data_12m %>% filter(distancia>=12, condicion%in%c("WW","LL")),
control = lmerControl(optimizer = "bobyqa"))
lme4::isSingular(lmer.12m, tol = 1e-4)
